# Fonction DP

def compute_DP(f, G, coeffs, N):
    """
    Evaluate the polynomial model DP(f, G) at a given order N.

    Parameters
    ----------
    f      : float  — frequency in GHz
    G      : float  — graphite percentage (%)
    coeffs : dict   — {(i, j): a_ij, ...}
    N      : int    — polynomial order

    Returns
    -------
    float — model output (epsilon_r or sigma)
    """
    result = 0.0
    for i in range(N + 1):
        for j in range(N - i + 1):
            a_ij = coeffs.get((i, j), 0.0)
            result += a_ij * (f ** i) * (G ** j)
    return result

# Cahier des charges
EPS_MAX = 20.0  # epsilon_r threshold
SIGMA_MAX = 0.2  # sigma threshold

# Parametrage
import numpy as np
import matplotlib.pyplot as plt

G_range = np.arange(0, 101, 1)  # graphite percentage from 0 to 100 (step 1)
F_range = np.linspace(F_MIN_GHZ, F_MAX_GHZ, F_POINTS)  # GHz

F_grid, G_grid = np.meshgrid(F_range, G_range)

def compute_DP_grid(F, G, coeffs, N):
    result = np.zeros_like(F, dtype=float)
    for i in range(N + 1):
        for j in range(N - i + 1):
            a_ij = coeffs.get((i, j), 0.0)
            result += a_ij * (F ** i) * (G ** j)
    return result

for N, eps_coeffs, sig_coeffs in [
    (2, eps_N2, sig_N2),
    (3, eps_N3, sig_N3),
    (4, eps_N4, sig_N4),
]:
    eps_vals = compute_DP_grid(F_grid, G_grid, eps_coeffs, N)
    sig_vals = compute_DP_grid(F_grid, G_grid, sig_coeffs, N)

    fig, (ax_eps, ax_sig) = plt.subplots(1, 2, figsize=(14, 6), sharex=True, sharey=True)

    eps_map = ax_eps.imshow(
        eps_vals,
        origin="lower",
        aspect="auto",
        extent=[F_MIN_GHZ, F_MAX_GHZ, G_range.min(), G_range.max()],
        cmap="viridis",
    )
    ax_eps.contour(
        F_grid,
        G_grid,
        eps_vals,
        levels=[EPS_MAX],
        colors="white",
        linewidths=1.2,
    )
    ax_eps.set_title(f"epsilon_r (N={N})")
    ax_eps.set_xlabel("Frequency [GHz]")
    ax_eps.set_ylabel("G (%)")

    sig_map = ax_sig.imshow(
        sig_vals,
        origin="lower",
        aspect="auto",
        extent=[F_MIN_GHZ, F_MAX_GHZ, G_range.min(), G_range.max()],
        cmap="magma",
    )
    ax_sig.contour(
        F_grid,
        G_grid,
        sig_vals,
        levels=[SIGMA_MAX],
        colors="white",
        linewidths=1.2,
    )
    ax_sig.set_title(f"sigma (N={N})")
    ax_sig.set_xlabel("Frequency [GHz]")

    fig.suptitle("DP maps over frequency and graphite percentage")
    fig.colorbar(eps_map, ax=ax_eps, label="epsilon_r")
    fig.colorbar(sig_map, ax=ax_sig, label="sigma [S/m]")

    plt.tight_layout()
    output_png = f"dp_maps_N{N}.png"
    plt.savefig(output_png, dpi=200)
    plt.show()